# apps/panel y apps/club (copiar a apps/<app>/.env.local)
# Con Supabase local: `pnpm supabase status` muestra API URL y anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Edge Functions (local: supabase/functions/.env · nube: supabase secrets set ...)
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@hibeely.com
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
CLUB_DOMINIO_BASE=hibeely.com
